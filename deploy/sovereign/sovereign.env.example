# Lodestone Sovereign — copier en deploy/sovereign/.env et remplir.
# Ce fichier contient des secrets : ne pas le versionner.

# --- Secrets (obligatoires) ---------------------------------------------------
# Générer avec : openssl rand -hex 32
# (hexadécimal : le mot de passe est inséré dans une URL postgres://, où des
# caractères comme / + @ casseraient la connexion)
POSTGRES_PASSWORD=
# Générer avec : openssl rand -hex 48
JWT_SECRET=

# --- URLs (obligatoires) -------------------------------------------------------
# URL publique du front, telle que la voit le navigateur des utilisateurs.
APP_BASE_URL=https://lodestone.mon-entreprise.local
# Origines autorisées à appeler l'API (en général : la même URL).
CORS_ALLOWED_ORIGINS=https://lodestone.mon-entreprise.local

# --- Modèles (facultatif) -------------------------------------------------------
# nomic-embed-text : 768 dimensions, ne pas changer sans lire le guide
# (« Changer de modèle d'embedding »).
EMBEDDING_MODEL=nomic-embed-text
# Modèle de génération : llama3.1 (8B) par défaut ; qwen2.5:14b ou plus si GPU.
CHAT_MODEL=llama3.1

# --- Réseau (facultatif) --------------------------------------------------------
# Par défaut, le serveur n'écoute que sur la machine (reverse proxy en frontal).
LODESTONE_BIND=127.0.0.1
LODESTONE_PORT=8090

# --- Versions (conseillé en production : figer) ---------------------------------
# OLLAMA_VERSION=0.12.6
# LODESTONE_VERSION=1.0.0
